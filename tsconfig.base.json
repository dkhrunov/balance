{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strict": false,
        "paths": {
            "@balance/dto": ["./libs/dto/src/index.ts"],
            "@balance/dto/auth": ["./libs/dto/src/lib/auth/index.ts"],
            "@balance/dto/users": ["./libs/dto/src/lib/users/index.ts"],
            "@balance/dto/accounts": ["./libs/dto/src/lib/accounts/index.ts"],
            "@balance/dto/categories": ["./libs/dto/src/lib/categories/index.ts"],
            "@balance/dto/transactions": ["./libs/dto/src/lib/transactions/index.ts"],
            "@balance/dto/currencies": ["./libs/dto/src/lib/currencies/index.ts"],
            "@balance/dto/common": ["./libs/dto/src/lib/common/index.ts"],
            "@balance/dto/sync": ["./libs/dto/src/lib/sync/index.ts"],
            "@balance/domain": ["./libs/domain/src/index.ts"],
            "@balance/domain/money": ["./libs/domain/src/lib/money/index.ts"],
            "@balance/domain/currency": ["./libs/domain/src/lib/currency/index.ts"],
            "@balance/domain/duration": ["./libs/domain/src/lib/duration/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
