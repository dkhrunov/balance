# Copy to apps/api/.env for local development. Do not commit `.env`.
# Values must match docker-compose Postgres (root `.env.example` / defaults).

PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=balance
DATABASE_PASSWORD=balance
DATABASE_NAME=balance

# Generate a long random value for production; do not commit the real secret.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_SESSION_TTL=30d
WEB_ORIGIN=http://localhost:4200

# Used only by `npm run db:seed:admin`; never commit a real password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_DISPLAY_NAME=Administrator
SEED_ADMIN_DEFAULT_CURRENCY=RUB
