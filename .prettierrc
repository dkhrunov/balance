{
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 4,
    "trailingComma": "all",
    "arrowParens": "always",
    "bracketSpacing": true,
    "jsxSingleQuote": false,
    "overrides": [
        {
            "files": "*.md",
            "options": {
                "tabWidth": 2,
                "useTabs": false
            }
        }
    ]
}
