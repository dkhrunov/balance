{
    "name": "Balance",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start:web": "nx serve web",
        "start:api": "nx serve api",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:migrate": "node apps/api/scripts/migrate.mjs",
        "db:migrate:down": "node apps/api/scripts/migrate.mjs --down",
        "db:seed:admin": "node apps/api/scripts/seed-admin.mjs",
        "build": "nx run-many -t build --projects=web,api",
        "graph": "nx graph",
        "lint": "nx run-many -t lint",
        "lint:styles": "stylelint \"**/*.{css,scss}\"",
        "typecheck": "nx run-many -t typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.8.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@nx/eslint": "23.1.1",
        "@nx/eslint-plugin": "23.1.1",
        "@nx/js": "^23.1.1",
        "@nx/nest": "^23.1.1",
        "@nx/node": "23.1.1",
        "@nx/react": "^23.1.1",
        "@nx/vite": "23.1.1",
        "@nx/web": "23.1.1",
        "@nx/webpack": "23.1.1",
        "@swc/cli": "~0.8.1",
        "@swc/core": "~1.15.5",
        "@swc/helpers": "~0.5.18",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@ts-safeql/eslint-plugin": "^5.4.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.21.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/supertest": "^7.2.1",
        "@vitejs/plugin-react": "^6.0.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.8.0",
        "eslint-plugin-ai-guard": "^1.3.0",
        "eslint-plugin-de-morgan": "^2.1.3",
        "eslint-plugin-import": "2.31.0",
